# Google OAuth / service-account credential downloads — never commit
client_secret_*.json
*-service-account*.json

# Dependencies
node_modules

# Build output
dist
dist-ssr

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local

# Wrangler
.wrangler
.dev.vars
# Auto-generated by `wrangler types` from wrangler.toml. Source of truth is
# the .toml plus the hand-written Env interface in backend/src/types.ts.
backend/worker-configuration.d.ts

# Recovery scripts (not part of the app)
.recovery

.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Local DB backups (business data — never commit)
.backups/

.superpowers/

# nodeterm canvas — зөвхөн энэ машин дээрх сесс/зураглалын төлөв (board-log,
# нээлттэй node-ууд).  Апп-ын код биш тул commit хийхгүй.
.nodeterm/

# /design-sync — skill scratch + regenerated build output + machine state.
# Durable inputs under .design-sync/ (config.json, NOTES.md, conventions.md,
# previews/, overrides/) ARE committed; the rest is ignored.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
frontend/.ds-sync-entry.tsx

# revit-mcp module — code IS tracked in mgl.  Exclude only the large Revit
# demo model (38MB binary; it also lives in the Anandshde/REVIT-MCP repo).
revit-mcp/output/*.rvt
frontend/.codemod-out/

# nodeterm canvas state — node байрлал/төлөв, амьдаар бичигддэг.
# Track хийвэл git status байнга бохир, pull бүрд мөргөлдөнө.
.nodeterm/

# Storage/D1 audit output (scripts/cleanup/*) — inventories, manifests, logs
backend/cleanup-out/
