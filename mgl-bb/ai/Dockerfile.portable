FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tar \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY packages/mglai-common /workspace/packages/mglai-common
COPY ai /workspace/ai

WORKDIR /workspace/ai
RUN npm ci

ENV MGLAI_DATA_DIR=/data
VOLUME ["/data"]

# Runtime intentionally binds only to 127.0.0.1. On a Linux server use
# --network host and, when remote access is needed, an SSH tunnel.
CMD ["sh", "-lc", "node --experimental-strip-types scripts/portable-install.mjs --no-start && node --experimental-strip-types scripts/portable-runtime.mjs foreground"]
