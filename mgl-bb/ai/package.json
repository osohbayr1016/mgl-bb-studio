{
  "name": "mgl-ai",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "MGL AI — Монголын архитектур, барилгын AI давхарга.  Локал инференс, төлбөргүй.",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "ai:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1 -Install",
    "ai:baseline:freeze": "node evaluation/freeze-baseline.mjs",
    "ai:bench:responsiveness": "node scripts/bench-responsiveness.mjs",
    "ai:benchmark": "node scripts/benchmark.mjs",
    "ai:build:l2": "node norm-dataset/tools/build-l2.mjs",
    "ai:build:l2:candidates": "node norm-dataset/tools/gen-l2-candidates.mjs",
    "ai:build:l2:cases": "node norm-dataset/tools/gen-l2-cases.mjs",
    "ai:build:l2:review": "node norm-dataset/tools/gen-l2-review.mjs",
    "ai:build:sft": "node training/build_behavior_sft.mjs",
    "ai:chat": "node --experimental-strip-types scripts/chat.mjs",
    "ai:check": "npm run ai:portable:check && tsc --noEmit && node --test \"runtime/test/**/*.test.ts\" \"retrieval/test/**/*.test.ts\" \"norm-compiler/test/**/*.test.ts\" \"deployment/test/**/*.test.ts\" \"evaluation/parity/*.test.mjs\"",
    "ai:compare": "node evaluation/compare-candidate.mjs",
    "ai:dataset": "node training/build_dataset.mjs",
    "ai:dataset:repr": "node --experimental-strip-types scripts/normalize-dataset-repr.mjs",
    "ai:deploy:diagnostics": "node deployment/bin/health.ts --diagnostics",
    "ai:deploy:health": "node deployment/bin/health.ts",
    "ai:deploy:plan": "node deployment/bin/update.ts --plan",
    "ai:deploy:test": "node --test \"deployment/test/**/*.test.ts\"",
    "ai:deploy:update": "node deployment/bin/update.ts",
    "ai:dev": "node runtime/src/server.ts",
    "ai:doctor": "node scripts/doctor.mjs",
    "ai:embed:norm": "node scripts/embed-norm.mjs",
    "ai:eval:aec": "node evaluation/heldout-gen.mjs --only H39,H40,H41,H42,H43,H44,H45,H46,H47,H48,H49,H50",
    "ai:eval:company": "node evaluation/company-golden.mjs",
    "ai:eval:conv": "node evaluation/conversation-e2e.mjs",
    "ai:eval:gold": "node evaluation/norm-gold.mjs",
    "ai:eval:heldout": "node evaluation/heldout-gen.mjs",
    "ai:eval:human40": "node --test evaluation/human40-v2.test.mjs",
    "ai:eval:l2": "node evaluation/l2-explain.mjs",
    "ai:eval:latin-roast": "node evaluation/latin-aec-roast.mjs",
    "ai:eval:mn": "node evaluation/mn-conversation.mjs",
    "ai:eval:norm": "node evaluation/norm-golden.mjs",
    "ai:eval:norm40": "node evaluation/norm40-v1.mjs",
    "ai:eval:reasoning": "node evaluation/reasoning-v1.mjs",
    "ai:eval:reasoning:adversarial": "node evaluation/reasoning-v1.mjs --mode adversarial",
    "ai:eval:reasoning:compare": "node evaluation/reasoning-v1/compare.mjs",
    "ai:eval:reasoning:full": "node evaluation/reasoning-v1.mjs --mode full",
    "ai:eval:reasoning:model": "node evaluation/reasoning-v1.mjs --mode model",
    "ai:eval:reasoning:structural": "node evaluation/reasoning-v1.mjs --mode structural",
    "ai:eval:reasoning:test": "node --test \"evaluation/reasoning-v1/lib/*.test.mjs\"",
    "ai:eval:replay": "node evaluation/engine-replay.mjs",
    "ai:eval:retrieval": "node evaluation/retrieval-modes.mjs",
    "ai:eval:style": "node evaluation/style-pairs.mjs",
    "ai:export-feedback": "node scripts/export-feedback.mjs",
    "ai:ingest": "node scripts/ingest.mjs",
    "ai:ingest:l2": "node scripts/ingest-l2.mjs",
    "ai:ingest:norm": "node scripts/ingest-norm.mjs",
    "ai:ingest:registry": "node scripts/ingest-registry.mjs",
    "ai:install:portable": "node --experimental-strip-types scripts/portable-install.mjs",
    "ai:lint:dataset": "node tools/dataset-lint/lint.mjs",
    "ai:lint:training": "node tools/training-lint/lint.mjs",
    "ai:model": "node scripts/model.mjs",
    "ai:norm:gate": "node --experimental-strip-types norm-dataset/tools/gate.mjs",
    "ai:norm:generate": "node --experimental-strip-types norm-compiler/cli.ts",
    "ai:norm:highrise:audit": "node norm-dataset/tools/highrise-coverage.mjs",
    "ai:norm:highrise:audit:strict": "node norm-dataset/tools/highrise-coverage.mjs --strict",
    "ai:norm:pack": "node norm-dataset/tools/build-pack.mjs",
    "ai:norm:parse": "python norm-dataset/tools/parse_pdf.py",
    "ai:norm:registry": "node norm-dataset/tools/build-registry.mjs",
    "ai:norm:training-ready": "node norm-dataset/tools/build-training-ready.mjs",
    "ai:pack": "node scripts/publish-installer.mjs --pack-runtime",
    "ai:parity": "node --test \"evaluation/parity/*.test.mjs\"",
    "ai:perf": "node evaluation/production-readiness/perf-baseline.mjs",
    "ai:portable:check": "node --check scripts/portable-install.mjs && node --check scripts/portable-runtime.mjs && node --check scripts/chat.mjs && node --experimental-strip-types -e \"import('./runtime/src/config.ts').then(m=>{if(typeof m.loadConfig!=='function')process.exit(1)})\"",
    "ai:publish": "node scripts/publish-installer.mjs",
    "ai:quantize": "python training/quantize.py",
    "ai:readiness": "node evaluation/production-readiness/scorecard.mjs",
    "ai:readiness:quick": "node evaluation/production-readiness/scorecard.mjs --quick",
    "ai:readiness:suites": "node --test \"evaluation/production-readiness/suites/*.test.mjs\"",
    "ai:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1 -Restart",
    "ai:restart:portable": "node --experimental-strip-types scripts/portable-runtime.mjs restart",
    "ai:run:portable": "node --experimental-strip-types scripts/portable-runtime.mjs foreground",
    "ai:setup": "node scripts/setup.mjs",
    "ai:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "ai:start:portable": "node --experimental-strip-types scripts/portable-runtime.mjs start",
    "ai:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1 -Status",
    "ai:status:portable": "node --experimental-strip-types scripts/portable-runtime.mjs status",
    "ai:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1 -Stop",
    "ai:stop:portable": "node --experimental-strip-types scripts/portable-runtime.mjs stop",
    "ai:supervise": "node deployment/bin/supervise.ts",
    "ai:test": "node --test \"runtime/test/**/*.test.ts\" \"retrieval/test/**/*.test.ts\" \"norm-compiler/test/**/*.test.ts\" \"deployment/test/**/*.test.ts\" \"evaluation/parity/*.test.mjs\"",
    "ai:train": "python training/train_lora.py",
    "ai:train:bg": "node training/platform-run.mjs background",
    "ai:train:continuous": "powershell -NoProfile -ExecutionPolicy Bypass -File training/continuous.ps1",
    "ai:train:continuous:once": "powershell -NoProfile -ExecutionPolicy Bypass -File training/continuous.ps1 -Once",
    "ai:train:eval": "node training/eval-candidate.mjs",
    "ai:train:export": "training/.venv/Scripts/python.exe -X utf8 training/export_adapter.py",
    "ai:train:log": "powershell -NoProfile -ExecutionPolicy Bypass -File training/train.ps1 -Log",
    "ai:train:probe": "node training/platform-run.mjs probe",
    "ai:train:readiness": "node training/readiness.mjs",
    "ai:train:resume": "powershell -NoProfile -ExecutionPolicy Bypass -File training/train.ps1 -Resume",
    "ai:train:split": "node training/check-split.mjs",
    "ai:train:status": "powershell -NoProfile -ExecutionPolicy Bypass -File training/train.ps1 -Status",
    "ai:train:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File training/train.ps1 -Stop",
    "integration:check": "tsc --noEmit -p integration && node --test \"integration/test/**/*.test.ts\"",
    "integration:test": "node --test \"integration/test/**/*.test.ts\"",
    "mgl-ai:merge-forecast": "node integration/merge-forecast.mjs",
    "mgl-ai:verify": "node integration/verify.mjs",
    "mgl-ai:verify:e2e": "node integration/verify.mjs --e2e",
    "mgl-ai:verify:full": "node integration/verify.mjs --full",
    "ai:eval:quality:batch": "node evaluation/quality-cycle/batch.mjs",
    "ai:eval:quality:test": "node --test evaluation/quality-cycle/lib.test.mjs && node evaluation/quality-cycle/batch.mjs --size 40 --seed ci --dry-run"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@mgl/mglai-common": "file:../packages/mglai-common"
  }
}
