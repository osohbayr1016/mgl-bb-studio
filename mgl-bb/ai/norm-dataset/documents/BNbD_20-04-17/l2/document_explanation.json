      "linked_clauses": []
    },
    {
      "term": "Дивержинг",
      "definition": "өөрөө өдөөгдөж үүсдэг аэродинамикийн тогтворгүй хэлбэлзэл. Тэгш хэмгүй хөндлөн огтлолтой буюу хөндлөн огтлолын хүндийн төв нь хөшүүний төвтэйгээ давхцаагүй барилгад үүсч болзошгүй",
      "definition_id": "БНбД 20-04-17#DEF:дивержинг",
