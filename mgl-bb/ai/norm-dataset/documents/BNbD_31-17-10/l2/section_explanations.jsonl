{"type":"section_explanation","schema_version":"l2-section/1","norm_code":"БНбД 31-17-10","section":"15","title":"АРИУН ЦЭВЭР, ЭРҮҮЛ АХУЙН ШААРДЛАГУУД","page":49,"clause_ids":["15.1","15.2","15.3","15.4","15.5","15.6","15.7","15.8","15.9","15.10","15.11","15.12","15.13","15.14"],"clause_count":14,"requirement_types":{"informational":2,"obligation":9,"reference":3},"first_clause":{"clause_id":"15.1","text":"Өндөр барилга барьж байгуулах, төсөл хийхдээ СанПиН 2.1.2.1002-00 болон MNS 58-25:2007 “Орон сууц олон нийтийн барилга. Өрөөний бичил уур амьсгалын үзүүлэлт” стандарттай уялдуулан байгаль орчин, хүний эрүүл мэндийг хамгаалах экологийн болон ариун цэврийн шаардлагыг хангасан арга хэмжээг урьдчилан ту"},"cross_documents":["СанПиН 2.1.2.1002-00","MNS 58-25","БНбД 23-05-10","БНбД 41-01-11","БНбД 31-01-01","БНбД 23-02-08","СанПиН 2.2.4/2.1.8.566-96"],"numeric_literal_count":5,"source":{"url":"https://mcis.gov.mn/main/single/16201345052562","pdf_url":"https://mcis.gov.mn/storage/uploads/process/202206/file_1654224802226730_161611878330710.pdf","document_sha256":"005f941b814e88a3c1dd707d7bb2958777d4ad73cec2df4b8511af1559ab858f"},"verification":{"explanation":"AUTO_DRAFT"},"execution":{"computable":false}}
