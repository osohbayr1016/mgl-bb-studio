{"type":"section_explanation","schema_version":"l2-section/1","norm_code":"БНбД 31-17-10","section":"17","title":"25 ДАВХАРААС 35 ДАВХАР БАРИЛГЫН ЗУРАГ ТӨСӨЛ ЗОХИОХОД МӨРДӨХ НЭМЭЛТ ШААРДЛАГУУД","page":52,"clause_ids":["17.1","17.2","17.3","17.4","17.5","17.6"],"clause_count":6,"requirement_types":{"obligation":6},"first_clause":{"clause_id":"17.1","text":"26 давхар(100м)-аас 35 давхар (150м) өндөр барилгын зураг төсөл зохиоход энэ нормын бусад бүлгүүдэд заасан шаардлагаас гадна энэ хэсэгт заасан шаардлагыг дагаж мөрдөнө."},"cross_documents":[],"numeric_literal_count":23,"source":{"url":"https://mcis.gov.mn/main/single/16201345052562","pdf_url":"https://mcis.gov.mn/storage/uploads/process/202206/file_1654224802226730_161611878330710.pdf","document_sha256":"005f941b814e88a3c1dd707d7bb2958777d4ad73cec2df4b8511af1559ab858f"},"verification":{"explanation":"AUTO_DRAFT"},"execution":{"computable":false}}
