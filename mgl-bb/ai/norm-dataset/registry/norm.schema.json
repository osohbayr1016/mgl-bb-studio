{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormRegistryRecord",
  "description": "One row of ai/norm-dataset/registry/norms.jsonl (GENERATED by tools/build-registry.mjs from norms.seed.jsonl + mcis_verification.json + documents/*/metadata.json). L0 = the AI knows the norm exists, its status, teams/topics and official link — even when no clause text is ingested.",
  "type": "object",
  "required": ["canonical_code", "title_mn", "document_type", "status", "status_evidence", "capability_level", "priority", "teams", "topics", "aliases", "retrieval_default", "deep_ingestion_status", "last_verified"],
  "properties": {
    "canonical_code": {"type": "string", "description": "Exactly as the MCIS register prints it (incl. * and */YY suffixes)"},
    "code_key": {"type": "string", "description": "Folded matching key: lowercase, no spaces, hyphens only"},
    "title_mn": {"type": "string"},
    "title_en": {"type": ["string", "null"]},
    "document_type": {"enum": ["BNbD", "BD", "UBB", "SNiP", "MNS", "OTHER"]},
    "status": {"enum": ["ACTIVE", "SUPERSEDED", "DRAFT", "GUIDANCE", "CANDIDATE_NEEDS_STATUS_CHECK", "HISTORICAL"]},
    "status_evidence": {"type": "array", "items": {"type": "string"}, "description": "Never empty: what was checked, where, when"},
    "effective_status": {"type": ["string", "null"], "description": "Local-knowledge-DB vocabulary (in_force | current_status_not_checked_for_later_amendments | …) — feeds currentness.ts"},
    "capability_level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
    "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
    "teams": {"type": "array", "items": {"type": "string"}, "description": "Keys of taxonomy/team_topic_map.json#teams"},
    "topics": {"type": "array", "items": {"type": "string"}, "description": "Keys of taxonomy/team_topic_map.json#topics"},
    "building_types": {"type": "array", "items": {"type": "string"}},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "supersedes_evidence": {"type": ["string", "null"]},
    "superseded_by": {"type": ["string", "null"]},
    "successor_draft": {"type": ["string", "null"]},
    "draft_of": {"type": ["string", "null"]},
    "amends": {"type": ["string", "null"]},
    "approval": {"type": ["string", "null"], "description": "Approving order as printed by the register"},
    "source_url": {"type": ["string", "null"], "description": "Official register page (MCIS) — the link to show"},
    "source_pdf_url": {"type": ["string", "null"]},
    "legal_source_url": {"type": ["string", "null"], "description": "legalinfo.mn order page when known"},
    "source_type": {"enum": ["mcis_register", "legalinfo", "official_draft", "official", "unresolved"]},
    "retrieval_default": {"type": "boolean", "description": "false for DRAFT/SUPERSEDED/HISTORICAL — excluded from current-answer routing unless asked"},
    "deep_ingestion_status": {"enum": ["NOT_STARTED", "PDF_READY", "PARSED", "CLAUSED", "TABLED", "FORMULAS_READY", "GOLD"]},
    "document_dir": {"type": ["string", "null"], "description": "documents/<dir> in this dataset"},
    "local_pack": {"type": ["string", "null"], "description": "ai/data-train-files/<pack> already ingestable"},
    "note": {"type": ["string", "null"]},
    "last_verified": {"type": "string"}
  }
}
