<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Туршилт: LIRA-гүйгээр LiraReader → MosaicRenderer → DisplacementPageBuilder → DocxBuilder гинжийг шалгана.
    Хуурамч IResultLiraAPI нь LIRA-ийн текст загвараас (.txt, «( 1/» элемент, «( 4/» координат) тор уншина.
    LiraAPI/FEModel-ийг LIRA-ийн bin64-оос ачаална (хуулахгүй).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LiraBin Condition="'$(LiraBin)' == ''">C:\Program Files\Lira Soft\Lira10.12\bin64</LiraBin>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MglLiraReport.csproj" />
    <Reference Include="LiraAPI"><HintPath>$(LiraBin)\LiraAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FEModel"><HintPath>$(LiraBin)\FEModel.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
