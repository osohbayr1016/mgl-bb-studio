<Window x:Class="RevitMcpAddin.BindingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MGL — Ажилтай холбох"
        Width="1040"
        Height="680"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Алгассан мөрийн бичвэр саарал (төлөв бичвэрээр ч бас харагдана).  `BasedOn` БИШ: нийтлэг загвар
             ажиллах үед л (MglTheme.Apply) нэмэгдэх тул StaticResource-аар лавлах боломжгүй. -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0 тайлбар -->
            <RowDefinition Height="Auto" />   <!-- 1 хайлт + шүүлт -->
            <RowDefinition Height="Auto" />   <!-- 2 чагтлах товчнууд + тоолуур -->
            <RowDefinition Height="*" />      <!-- 3 хүснэгт -->
            <RowDefinition Height="Auto" />   <!-- 4 дэд жагсаалт -->
            <RowDefinition Height="Auto" />   <!-- 5 товчны мөр -->
        </Grid.RowDefinitions>

        <!-- Юу хийдэг, чагтлаагүй мөр юу болдгийг ИЛ хэлнэ (өмнө нь зөвхөн энд, урт догол мөрийн төгсгөлд байв). -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="IntroText" Style="{DynamicResource MglBody}"
                       Text="Revit-ийн хуудас бүрийг ERP дээрх зураг, тасктай холбоно. Систем санал болгож бөглөсөн — та зөвхөн шалгаад буруу мөрийг засна. Файл тутамд нэг удаа хийхэд хангалттай: хуудасны дугаар, нэр солигдсон ч холбоос үлдэнэ." />
            <TextBlock x:Name="RuleText" Style="{DynamicResource MglMuted}" Margin="0,4,0,0"
                       Text="Чагтласан мөр холбогдоно. Чагтлаагүй мөр «алгассан» гэж хадгалагдана — дараагийн удаа санал болгохгүй, гэхдээ саараар харагдаж, хүссэн үедээ дахин чагталж болно." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SearchLabel" Grid.Column="0" Text="Хайх (хуудасны дугаар эсвэл нэр)" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBox_TextChanged" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <TextBlock x:Name="FilterLabel" Text="Харуулах" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="FilterCombo" MinWidth="170" SelectionChanged="FilterCombo_SelectionChanged" />
            </StackPanel>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <Button x:Name="CheckHighBtn" Content="Итгэлтэй мөрийг чагтлах" Click="CheckHighBtn_Click" Margin="0,0,8,4"
                    ToolTip="Итгэл 0.80-аас дээш БА ERP таск сонгогдсон мөрийг чагтална; бусад мөрийн чагтыг авна. Зураг, таскийн сонголтыг өөрчлөхгүй." />
            <Button x:Name="CheckAllBtn" Content="Бүгдийг чагтлах" Click="CheckAllBtn_Click" Margin="0,0,8,4"
                    ToolTip="ERP таск сонгогдсон бүх мөрийг чагтална; таскгүй мөрийн чагтыг авна. Зураг, таскийн сонголтыг өөрчлөхгүй." />
            <Button x:Name="ClearBtn" Content="Сонголт цуцлах" Click="ClearBtn_Click" Margin="0,0,8,4"
                    ToolTip="Бүх чагтыг авна (дараа нь хадгалбал бүх хуудас «алгассан» болно). Зураг, таскийн сонголтыг өөрчлөхгүй." />
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="6,0,0,4" Style="{DynamicResource MglBody}" />
        </WrapPanel>

        <DataGrid x:Name="Grid" Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single"
                  RowHeight="32"
                  AutomationProperties.Name="Revit хуудас ба ERP зураг, таскийн холбоосын жагсаалт">
            <DataGrid.Columns>
                <!-- DataGridCheckBoxColumn БИШ: тэр нь эхний даралтаар нүдийг «засварлах» горимд оруулаад ЗӨВХӨН хоёр дахь
                     даралтаар тэмдэглэдэг тул хэрэглэгч «дарсан ч юу ч болохгүй» гэж ойлгодог.  Загварт байрлуулсан
                     CheckBox нь даралтыг өөрөө авдаг тул нэг даралтаар ажиллана. -->
                <DataGridTemplateColumn Header="Холбох" Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      AutomationProperties.Name="Энэ хуудсыг холбох" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Revit хуудас" Binding="{Binding SheetNumber}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Хуудасны нэр" Binding="{Binding SheetName}" Width="220" IsReadOnly="True" ElementStyle="{StaticResource CellText}" />
                <DataGridTemplateColumn Header="ERP зураг" Width="230">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DrawingOptions}"
                                      SelectedItem="{Binding SelectedDrawing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Label"
                                      AutomationProperties.Name="ERP зураг сонгох" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="ERP таск" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding TaskOptions}"
                                      SelectedItem="{Binding SelectedTask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Label"
                                      AutomationProperties.Name="ERP таск сонгох" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Төлөв бичвэрээр (өмнө нь «алгассан» мөр зөвхөн саарал байв). -->
                <DataGridTextColumn Header="Төлөв" Binding="{Binding StatusLabel}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Binding="{Binding ConfidenceLabel}" Width="64" IsReadOnly="True" ElementStyle="{StaticResource CellText}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Итгэл"
                                   ToolTip="Системийн таамагласан оноо (магадлал БИШ): хуудасны дугаарын үсэг зурагтай, нэр таскийн нэртэй таарвал өндөр. 0.80-аас дээш мөрийг урьдчилан чагталдаг. Хадгалсны дараа 1.00 болж «гараар баталсан» гэж тэмдэглэгдэнэ. «—» = санал байхгүй." />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <CheckBox x:Name="SeedChecklistBox" Grid.Row="4" IsChecked="True" Margin="0,10,0,0">
            <TextBlock TextWrapping="Wrap">
                Холбосон ажил бүрийг дэд жагсаалтад автоматаар нэмэх
                <Run Foreground="{DynamicResource FgMuted}" Text="— ажлын явцыг үүнээс тооцно (жишээ нь 8 / 13 → 62%). Аль хэдийн байгаа мөрийг дахин нэмэхгүй." />
            </TextBlock>
        </CheckBox>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Warn}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SaveBtn" Content="Холбоос хадгалах" Width="150" IsDefault="True" Click="SaveBtn_Click" />
                <Button x:Name="CloseBtn" Content="Хаах" Width="90" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
