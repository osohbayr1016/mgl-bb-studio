<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Multi-version Revit add-in. Нэг DLL бүх Revit-д ачаалагдахгүй (Revit хувилбар
    бүр өөр .NET runtime): 2024=net48, 2025/2026=net8, 2027=net10. Тиймээс Revit
    оноор нэг Configuration: "Release R24".."Release R27". Config болбүр өөрийн TFM,
    RevitAPI пакетийн хувилбар, deploy folder-той.

      dotnet build RevitMcpAddin.csproj -c "Release R27" -p:Platform=x64
  -->

  <PropertyGroup>
    <Configurations>Debug R24;Debug R25;Debug R26;Debug R27;Release R24;Release R25;Release R26;Release R27</Configurations>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RevitMcpAddin</AssemblyName>
    <RootNamespace>RevitMcpAddin</RootNamespace>
    <!-- Тархаалтыг цомхотгох: Roslyn-ы бусад хэлний (cs/de/ja/ru...) алдааны
         resources.dll-үүдийг хасна — add-in-д хэрэггүй, ~6 MB / 56 файл хэмнэнэ. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- NU1510 нь RESTORE-ийн үеийн анхааруулга тул PackageReference дээрх
         NoWarn түүнийг дардаггүй — project түвшинд бичих ёстой.
         net10-д ProtectedData framework-д орсон тул "илүүц" гэж хэлдэг, гэвч
         net8 (Revit 2025/2026)-д ХЭРЭГТЭЙ тул пакетыг хасахгүй. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>

