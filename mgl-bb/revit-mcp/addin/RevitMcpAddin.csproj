                                   «Ханын дэлгээс» интерьерийн 2–3-р тойрог + «+ Хана нэмэх» (1.44.0, 1.45.0).  2026-10-16 merge
                                   (feat/engineering-feedback-we-2026-10-16): main + feat/roomplan-furniture-tiers = тараасан 1.45.0-ийн эх код.

      1.45.0 -> 1.46.0 (2026-10-16, feat/engineering-feedback-we-2026-10-16; ТАРААГААГҮЙ — release gate-ийн candidate):
                                   «Ханын дэлгээс» инженерийн санал хүсэлт W01–W10 (арын ажлын дахин төлөвлөлт, нэг хуудас, масштаб,
                                   маркерын төв, дугаарлалт, үр дүнгийн хөтөч, босоо хүрээ, шал/таазны бодит нүүр, өрөөний зориулалт,
                                   муруй ханын шударга тайлбар) + «Санал хүсэлт» (F01–F05) + суулгагч/gate (V01–V04).

      ⚠️ Энэ тоог өсгөсний ДАРАА дөрвүүлэн Configuration-ыг ДАХИН барь.
      `package-addin.ps1` нь DLL-ийн `FileVersion`-ыг энэ утгатай тулгаж,
      таарахгүй бол «ХУУЧИРСАН» гэж ЗОГСОНО (худал манифест гаргахгүй).
    -->
    <Version>1.46.0</Version>
    <FileVersion>1.46.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <!-- BuildInfo.Version (лиценз, health, User-Agent) үүнийг уншдаг: 1.37.0-д гацсан байсан тул 1.38–1.41 бүгд «1.37.0» гэж мэдээлж байв. -->
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <!-- Configuration (Revit он) -> RevitVersion + TargetFramework -->
  <PropertyGroup Condition="$(Configuration.Contains('R24'))">
    <RevitVersion>2024</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R25'))">
    <RevitVersion>2025</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R26'))">
    <RevitVersion>2026</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R27'))">
    <RevitVersion>2027</RevitVersion>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <!-- Fallback: Config нэрэнд Rxx байхгүй (ж: bare `dotnet build`) бол 2027-оор -->
  <PropertyGroup Condition="'$(TargetFramework)' == ''">
    <RevitVersion>2027</RevitVersion>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <!--
    ⚠️ ОПТИМИЗАЦИ.  Configuration нэрүүд нь "Release R24".."Release R27" тул
    .NET SDK-ийн стандарт `'$(Configuration)' == 'Release'` шалгуурт ХЭЗЭЭ Ч
    таардаггүй — өөрөөр хэлбэл өнөөг хүртэл БҮХ «Release Rxx» build нь
    csc-д `optimize-` буюу ОПТИМИЗАЦГҮЙ эмхэтгэгдэж байсан (`Optimize` нь
    энэ файлд ч, репо даяар ч, Directory.Build.props-д ч нэг ч газар
    байхгүй байв).  Латентын хэмжилт (Track 1C) ийм DLL дээр хийгдвэл
    системтэйгээр ПЕССИМИСТ тоо гаргана.  Тиймээс Release-ээр эхэлсэн бүх
    Configuration-д ил зааж өгнө.  Debug-д ЗОРИУДААР тавихгүй — SDK түүнийг
    unoptimized үлдээх нь зөв.
  -->
  <PropertyGroup Condition="$(Configuration.StartsWith('Release'))">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Deploy folder Revit оноор -->
  <PropertyGroup>
    <AddinDeployDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</AddinDeployDir>
  </PropertyGroup>

  <!-- Зөвхөн .NET (Core) target (net8/net10 = Revit 2025-2027): MCP код-гүйцэтгэгч
       + isolated load (deps.json). net48 (Revit 2024)-д MCP хасагдана. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <DefineConstants>$(DefineConstants);MCP_EXECUTOR</DefineConstants>
  </PropertyGroup>

  <!-- SESSION R — Revit Intelligence (`Intelligence/`): ЗӨВХӨН .NET (Core) target
       (net8/net10 = Revit 2025–2027).  net48 (Revit 2024)-д хасагдана (R-22) —
       хуучин add-in ХЭВЭЭР бүтнэ, шинэ архитектурыг хуучин framework-д
       тохируулж гажуулахгүй.  `App.cs` / `RevitTools.cs` / `AssistantPane`
       дахь залгаасууд `#if MGL_INTELLIGENCE`-ээр хамгаалагдсан. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
    <DefineConstants>$(DefineConstants);MGL_INTELLIGENCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Remove="Intelligence/**" />
    <Page Remove="Intelligence/**" />
  </ItemGroup>

  <!-- FAMILY HUB (POC, 2026-09-15) — `FamilyHub/`: нийтийн нийлүүлэгчээс family татаж
       ачаалах туршилт.  Intelligence-тэй ижил дүрмээр ЗӨВХӨН .NET (Core) target
       (Revit 2025–2027); net48 (Revit 2024)-д хасагдана.  `App.cs`-ийн ганц ribbon
       товч `#if MGL_FAMILYHUB`-аар хамгаалагдсан.  `FamilyHub/Core` нь Revit төрөлгүй —
       `tests/FamilyHub.Tests` шууд эмхэтгэдэг. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
    <DefineConstants>$(DefineConstants);MGL_FAMILYHUB</DefineConstants>
  </PropertyGroup>
  <!-- Family Hub-ийн BIMobject таб = WebView2 (жинхэнэ хөтөч: хэрэглэгч өөрөө нэвтэрч,
       өөрөө «Download» дарна; anti-bot/нэвтрэлт тойрохгүй).
       ⚠️ ХУВИЛБАР 1.0.2478.35 нь Revit 2027-ийн өөрийнх нь (AddIns\DynamoForRevit\
       Microsoft.Web.WebView2.Core.dll = 1.0.2478.35, хэмжсэн 2026-09-15) хувилбар —
       нэг процесст native WebView2Loader.dll нэг л удаа ачаалагддаг тул ӨӨР хувилбар
       авбал managed/native зөрөөд `EnsureCoreWebView2Async` унаж болзошгүй.  Revit
       шинэчлэгдвэл ЭНЭ тоог тэрний хамт шинэчил. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2478.35" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Remove="FamilyHub/**" />
    <Page Remove="FamilyHub/**" />
  </ItemGroup>

  <!-- АВТОМАТ ЦАГ БҮРТГЭЛ + АЖЛЫН САМБАР (Session 3–5, 2026-09-29) — `WorkTracking/`
       (цөм: `tests/WorkTracking.Tests` шууд эмхэтгэдэг, Revit төрөлгүй) ба
       `WorkPane/` («MGL ажил» самбар).  MVP нь ЗӨВХӨН Revit 2027 (эзний шийдвэр);
       Intelligence-ийн ижил дүрмээр net8/net10-д эмхэтгэгдэж, net48 (Revit 2024)-д
       хасагдана.  `App.cs`-ийн залгаасууд `#if MGL_WORK_TRACKING`-ээр хамгаалагдсан. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
    <DefineConstants>$(DefineConstants);MGL_WORK_TRACKING</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Remove="WorkTracking/**" />
    <Page Remove="WorkTracking/**" />
    <Compile Remove="WorkPane/**" />
    <Page Remove="WorkPane/**" />
  </ItemGroup>

  <!-- MGL SMART (2026-10-01) — Smart Publish, Smart Count, Clash Checker, Change Impact.
       Хавтсууд: `Smart/` (дундын суурь), `SmartPublish/`, `SmartCount/`, `ClashCheck/`,
       `ChangeImpact/` — тус бүрд `Core/` (Revit-гүй цэвэр логик; `tests/Smart.Tests` шууд
       эмхэтгэнэ), `Revit/` (API-тай нимгэн залгаас), `Ui/` (WPF).  WorkTracking/Intelligence-ийн
       ижил дүрмээр ЗӨВХӨН .NET (Core) target (Revit 2025–2027); net48 (Revit 2024)-д хасагдана.
       `App.cs`-ийн залгаасууд `#if MGL_SMART`-аар хамгаалагдсан. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
    <DefineConstants>$(DefineConstants);MGL_SMART</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Remove="Smart/**" />
    <Compile Remove="SmartPublish/**" />
    <Compile Remove="SmartCount/**" />
    <Compile Remove="ClashCheck/**" />
    <Compile Remove="ChangeImpact/**" />
  </ItemGroup>

  <!-- net48 (Revit 2024): System.Text.Json зэрэг сул DLL-ийн binding зөрчлийг
       багасгах (add-in .config үүсгэнэ). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <!-- Revit reference assemblies (Revit оноор). Зөвхөн compile — RevitAPI.dll-ийг
       output руу хуулахгүй (ExcludeAssets=runtime). Build машинд Revit суулгах
       шаардлагагүй. -->
  <!-- V02 (2026-10-16): Revit API багцыг он тус бүрд ТОГТМОЛ — тухайн оны АНХНЫ боломжит хувилбар.  Өмнөх хөвөгч
       `$(RevitVersion).*` нь 2027.3.0 / 2024.3.60 руу сэргээгдэж, 27.2 / 24.1 Revit дээр журналд «API_ERROR … Assembly version
       conflict … RevitAPI of version 27.3.0.0 conflicts with same preloaded module of version 27.2.0.0» гэж бичигддэг байв.
       Хамгийн бага хувилбар руу эмхэтгэхэд 0 алдаа (2026-10-16 хэмжсэн: 2024.0.0 / 2025.0.2 / 2026.0.4 / 2027.0.0) ⇒ тухайн
       оны дараагийн update-д нэмэгдсэн API хэрэглээгүй; тиймээс оны бүх update дээр ижил DLL ачаалагдана.
       Шинэ update-ийн API хэрэгтэй болбол энд ИЛ өсгөж, ажилтнуудын хамгийн бага update-ийг шалгана.
       Дарж бичих: `-p:RevitApiPackageVersion=2027.2.0`. -->
  <PropertyGroup Condition="'$(RevitApiPackageVersion)' == ''">
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2024'">2024.0.0</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2025'">2025.0.2</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2026'">2026.0.4</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2027'">2027.0.0</RevitApiPackageVersion>
  </PropertyGroup>
  <PropertyGroup>
    <RevitApiPackageVersion Condition="'$(RevitApiPackageVersion)' == ''">$(RevitVersion).*</RevitApiPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPackageVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPackageVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- DPAPI (ProtectedData) — жилийн хугацаатай API токеныг settings.json-д
       ил бичихгүйн тулд.  net8/net10 дээр framework-д БАЙХГҮЙ тул NuGet пакет
       шаардлагатай; net48 дээр System.Security.dll дотор байдаг (доор reference).
       ⚠️ Энэ хоёрын аль нэгийг мартвал тухайн Configuration build УНАНА. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <!-- NU1510: net10-д ProtectedData нь framework-д орсон тул пакет "илүүц"
         гэж анхааруулна.  net8 (Revit 2025/2026)-д ХЭРЭГТЭЙ тул хасахгүй —
         зөвхөн анхааруулгыг чимээгүй болгоно. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0"
                     NoWarn="NU1510" />
  </ItemGroup>

  <!-- Local Python stdlib planner; copy to the add-in output/bundle.
       Python 3 interpreter must be installed separately (no pip/AI/API).
       Nothing is automatically deployed to a live Revit installation. -->
  <ItemGroup>
    <Content Include="RoomPlan\Python\roomplan_cli.py"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="RoomPlan\Python\plan_archetypes.py"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="RoomPlan\Python\plan_validation.py"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="RoomPlan\Python\plan_generator.py"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="RoomPlan\Python\plan_furniture.py"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="RoomPlan\Python\roomplan_cli.exe"
             Condition="Exists('RoomPlan\Python\roomplan_cli.exe')"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- MGL UI — ДУНДЫН удирдлагын загвар (Ui/Resources/MglControls.xaml).
       ⚠️ `Page` БИШ, `EmbeddedResource`: ажиллах үед `XamlReader.Load`-оор уншина (pack:// URI хэрэглэхгүй) —
       repo-д ResourceDictionary/pack:// precedent байхгүй, add-in тусгаарласан assembly-load context-д ачаалагддаг,
       мөн WPF-ийн хоёр алхамт эмхэтгэл «BG1002 …baml cannot be found»-аар унадаг (docs/INSTALL_BUNDLE.md:30).
       Синтакс, төрлийн шалгалт: scratch төсөлд энэ файлыг `Page` болгон эмхэтгэнэ (docs/MGL_UI_UX_REDESIGN.md §2).
       LogicalName нь MglStyles.ResourceName-тэй ЯГ ИЖИЛ байх ёстой.  Бүх Configuration (R24 net48 орно)-д ИЖИЛ. -->
  <ItemGroup>
    <Page Remove="Ui\Resources\**\*.xaml" />
    <EmbeddedResource Include="Ui\Resources\MglControls.xaml" LogicalName="RevitMcpAddin.Ui.MglControls.xaml" />
  </ItemGroup>

  <!-- Санаа таних загвар — DLL дотор ШИГТГЭНЭ.  Ажилтны компьютерт
       нэмэлт файл, Python, интернэт ХЭРЭГГҮЙ.  Шинэ загвар гарвал add-in
       серверээс татаж %APPDATA%-д хадгална; энэ нь СУУРЬ хувилбар. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\intent-model.json"
                      Condition="Exists('Resources\intent-model.json')" />
  </ItemGroup>

  <!-- Дүрмийн багцын CANARY — DLL дотор ШИГТГЭНЭ.  Сүлжээгүй, эсвэл сервер
       404 өгөх үед RulePack.Load() нь гурав дахь түвшинд (юу ч алга) УНАХГҮЙ,
       энэ ХҮЧИНТЭЙ ХООСОН багц руу унана (v2 §75-ийн офлайн горим).
       ⚠️ Агуулгыг ГАРААР бүү засварла: pack_sha256 нь биеийнхээ MGL-CANON-1
       хэлбэрээс тооцогддог тул нэг тэмдэгт өөрчлөхөд RulePack.ParseVerified
       нь БҮХ БАГЦЫГ ТАТГАЛЗАНА (IntentModel.cs:311-312-ийн хэв маяг). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\rulepack-canary.json"
                      Condition="Exists('Resources\rulepack-canary.json')" />
  </ItemGroup>

  <!-- Roslyn scripting — зөвхөн MCP-тэй build (net8/net10). -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
  </ItemGroup>

  <!-- net48-д System.Text.Json нь NuGet (net8+ дээр built-in); + net48 targeting pack. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- System.Net.Http (HttpClient) нь net48-д framework assembly — SDK project-д
         автоматаар ирдэггүй тул гараар reference хийнэ (net8+ дээр built-in). -->
    <Reference Include="System.Net.Http" />
    <!-- ProtectedData (DPAPI) нь net48-д System.Security.dll дотор. -->
    <Reference Include="System.Security" />
  </ItemGroup>

  <!-- MCP код-гүйцэтгэгчийн 4 файлыг Revit-2024/net48 build-аас хасах
       (App.cs-ийн дуудлагууд #if MCP_EXECUTOR-оор хамгаалагдсан). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Remove="HttpServer.cs" />
    <Compile Remove="CodeExecutorEventHandler.cs" />
    <Compile Remove="ScriptGlobals.cs" />
    <Compile Remove="ExecuteRequest.cs" />
  </ItemGroup>

  <!-- Build дараа: гаралт (DLL + deps + .addin)-ыг тухайн Revit оны Addins folder
       (%APPDATA%\Autodesk\Revit\Addins\<он>) руу хуулна.

       ⚠️ ЗӨВХӨН ИЛ ЗӨВШӨӨРӨЛТЭЙ.  Энэ target урьд нь БОЛЗОЛГҮЙ байсан тул
       `dotnet build` БҮР нь энэ машины АМЬД Revit нэмэлтийг чимээгүйхэн дарж
       бичдэг байв.  2026-08-28-нд агентын энгийн `dotnet build` 2024/2025/
       2026/2027 дөрвүүлэн суулгацыг commit хийгээгүй WIP кодоор дарсан.
       Add-in-д АЛБАДАН ШИНЭЧЛЭХ МЕХАНИЗМ БАЙХГҮЙ (~20 ПК дээр гараар
       Install.bat) тул ийм санамсаргүй бичилтийг төвлөрсөн байдлаар буцаах
       арга алга — иймд суулгалт нь ЗОРИУДЫН үйлдэл байх ёстой.

       ⚠️ `Condition="'$(AddinDeployDir)' != ''"` гэж хамгаалах нь ЮУ Ч
       ХИЙХГҮЙ: AddinDeployDir нь дээрх «Deploy folder Revit оноор» бүлэгт
       болзолгүйгээр ҮРГЭЛЖ утга авдаг.  Тиймээс ТУСДАА, ил зөвшөөрлийн
       property (DeployToRevit) хэрэгтэй.

       Зориудаар суулгах:
         dotnet build RevitMcpAddin.csproj -c "Release R27" -p:Platform=x64 -p:DeployToRevit=true
       Revit нээлттэй (DLL түгжигдсэн) үед өөр фолдер руу:
         PowerShell:  ... -p:DeployToRevit=true -p:AddinDeployDir=C:\Temp\mgl
         Git Bash:    ... -p:DeployToRevit=true -p:AddinDeployDir='C:/Temp/mgl'
       ⚠️ Git Bash-д ЗАМЫГ ХАШИЛТАНД ХИЙЖ, ЗУРААСЫГ УРАГШ (/) бич.  Хашилтгүй
          C:\Temp\x гэж бичвэл bash тэмдэгтийг ИДЭЖ C:Tempx болгоно — тэр нь
          дискний ХАРЬЦАНГУЙ зам тул гаралт ТӨСЛИЙН ФОЛДЕР дотор буудаг.
          2026-08-28-нд яг ийм байдлаар addin/Tempaudit_optin/ дотор 11 МБ
          хоёртын файл үүсээд эх мод руу орох шахсан (устгав).

       Тараалт (`scripts\package-addin.ps1`) нь ЭНЭ target-д ТҮШИГЛЭДЭГГҮЙ:
       тэр bin\x64\<cfg> буюу энгийн build гаралтаас шууд савалдаг, тиймээс
       тэнд `-p:DeployToRevit=true` нэмэх ШААРДЛАГАГҮЙ. -->
  <Target Name="DeployAddin" AfterTargets="Build"
          Condition="'$(DeployToRevit)' == 'true'">
    <PropertyGroup>
      <DeployBin>$(AddinDeployDir)\RevitMcpAddin</DeployBin>
    </PropertyGroup>
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(DeployBin)" />
    <Copy SourceFiles="@(DeployFiles)"
          DestinationFiles="@(DeployFiles->'$(DeployBin)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(ProjectDir)RevitMcpAddin.addin"
          DestinationFolder="$(AddinDeployDir)"
          SkipUnchangedFiles="false" />
    <Message Importance="high" Text="Deployed Revit MCP add-in ($(RevitVersion)) to $(DeployBin)" />
  </Target>

</Project>
