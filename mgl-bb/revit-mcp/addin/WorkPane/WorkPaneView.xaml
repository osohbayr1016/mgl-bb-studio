<UserControl x:Class="RevitMcpAddin.WorkPane.WorkPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="280"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True">

    <!--
      «MGL ажил» — Revit work tracking MVP (Session 3, 2026-09-29).

      Палитр нь «MGL туслах» (`AssistantPane.xaml`)-тай ИЖИЛ — Revit 2027-ийн
      харанхуй сэдэв.  Эцэг самбарын resource-оос хамаарахгүйн тулд энд дахин
      тодорхойлов (хоёр dockable pane нь тусдаа WPF мод).

      ⚠️ Start / Pause / Stop ТОВЧ ЗОРИУД БАЙХГҮЙ (эзний шаардлага): цаг нь
         сонгосон таск дээр Revit урд байх + оролт идэвхтэй үед АВТОМАТААР
         тоологдоно (`WorkTracking/WorkTrackingHost`).  Энэ самбар зөвхөн
         «хэн, аль файл, аль таск» ба «явц, тайлан»-г эзэмшинэ.
      ⚠️ 2026-09-29 (эзний «хоёр тусдаа систем» шийдвэр): Revit-ийн автомат цаг
         бүртгэл ДАЛД — ажилтны ч, удирдлагын ч харагдац БАЙХГҮЙ.  Энэ самбар цаг,
         тоолж буй эсэх, өдрийн жагсаалтыг ХАРУУЛАХГҮЙ (`TrackingPanel` хасагдсан);
         албан ёсны цаг нь ERP-ийн «Миний ажлууд»-ын Play/Pause.  Тоолол хост дотор
         чимээгүй үргэлжилнэ.  Энд үлдсэн нь ажилтны ӨӨРИЙН илгээлтийн дараалал.
    -->
    <UserControl.Resources>
        <!-- ⚠️ ӨНГӨ ЭНД БАЙХГҮЙ: токенууд (Bg, BgRaised, Fg, FgMuted, Accent, …) нь `Ui/MglTheme.cs`-ээс (constructor-т
             `MglTheme.Apply(this, 12)`), `DynamicResource` — Revit-ийн Light/Dark/өндөр контраст солигдоход самбар шууд дахин
             будагдана.  Хуучин `AssistantPane`-тай хуулбарласан харанхуй палитр, ComboSurface/ComboRow/ChoiceRow, DarkBox/DarkPass/
             DarkCheck/DarkCombo хасагдсан: оролт, combo, жагсаалт, чагт нь `Ui/Resources/MglControls.xaml`-ийн implicit загвар. -->

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource MglFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource HoverFg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Pressed}" />
                                <Setter Property="Foreground" Value="{DynamicResource PressedFg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.55" />
                                <Setter Property="Foreground" Value="{DynamicResource FgDisabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Гол үйлдэл: Accent дэвсгэр.  `BasedOn` БИШ — hover нь саарал болж accent-ийг дарахгүйн тулд өөрийн template. -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource MglFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Fg}" />
                                <Setter TargetName="b" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Bg}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Line}" />
                                <Setter Property="Foreground" Value="{DynamicResource FgDisabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="DarkText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- ⚠️ Хоёрдогч бичвэр ≥ 12 DIP (өмнө нь 10–11). -->
        <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource DarkText}">
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource DarkText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Bg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10,10,10,12">

                <!-- ============ Толгой ============ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="MGL ажил" Style="{StaticResource DarkText}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="WhoText" Style="{StaticResource MutedText}" Text="Нэвтрээгүй" />
                    </StackPanel>
                    <Button x:Name="RefreshBtn" Grid.Column="1" Style="{StaticResource FlatButton}" Padding="8,3"
                            Content="Шинэчлэх" Click="RefreshBtn_Click" Margin="6,0,0,0"
                            ToolTip="Файл, төсөл, таскийн жагсаалтыг дахин уншиж, илгээгдээгүй тайланг шууд илгээнэ." />
                    <Button x:Name="LogoutBtn" Grid.Column="2" Style="{StaticResource LinkButton}"
                            Content="Гарах" Click="LogoutBtn_Click" Margin="4,0,0,0" Visibility="Collapsed"
                            AutomationProperties.Name="Бүртгэлээс гарах"
                            ToolTip="Бүртгэлээс гарах — энэ компьютер дээрх нэвтрэлт устна, дахин нэвтрэх хүртэл таск, тайлан ажиллахгүй." />
                </Grid>

                <!-- ============ Нэвтрэх ============ -->
                <Border x:Name="LoginCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DarkText}" FontWeight="SemiBold"
                                   Text="ERP-ийн нэр, нууц үгээрээ нэвтэрнэ үү" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,8"
                                   Text="Нууц үг хадгалагдахгүй — энэ компьютерт зөвхөн шифрлэгдсэн нэвтрэлтийн токен үлдэнэ." />
                        <TextBlock Style="{StaticResource MutedText}" Text="Нэвтрэх нэр" />
                        <TextBox x:Name="UserBox" Margin="0,2,0,6" AutomationProperties.Name="Нэвтрэх нэр" />
                        <TextBlock Style="{StaticResource MutedText}" Text="Нууц үг" />
                        <PasswordBox x:Name="PassBox" Margin="0,2,0,8" AutomationProperties.Name="Нууц үг"
                                     KeyDown="PassBox_KeyDown" />
                        <Button x:Name="LoginBtn" Style="{StaticResource PrimaryButton}" Content="Нэвтрэх"
                                HorizontalAlignment="Left" Click="LoginBtn_Click" />
                        <TextBlock x:Name="LoginStatus" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- ============ Ажлын хэсэг (нэвтэрсний дараа) ============ -->
                <StackPanel x:Name="WorkBody" Visibility="Collapsed">

                    <!--
                      ИЛГЭЭГДЭЭГҮЙ ТАЙЛАН — ажилтны ӨӨРИЙН илгээлтүүд (хостын дараалал
                      `WorkTrackingHost.Reports()`), цаг бүртгэл БИШ.  Сүлжээ / нэвтрэлт
                      хүлээж буй ба сервер татгалзсан тайлан (жишээ нь хувь буурсан,
                      төсөл цагаар бүртгэгддэг болсон) энд харагдана — эс бөгөөс текст нь
                      дискэнд хадгалагдсан хэвээр ажилтан мэдэхгүй үлдэнэ.  Код: `RenderOutbox`.
                    -->
                    <Border x:Name="OutboxCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="ИЛГЭЭГДЭЭГҮЙ ТАЙЛАН" />
                            <StackPanel x:Name="OutboxList" />
                        </StackPanel>
                    </Border>

                    <!-- Файл → төсөл → таск -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="ОДООГИЙН АЖИЛ" />
                            <TextBlock x:Name="DocLine" Style="{StaticResource DarkText}" FontSize="12" Text="Файл: —" />
                            <TextBlock x:Name="ProjectLine" Style="{StaticResource DarkText}" FontSize="12" Margin="0,2,0,0" Text="Төсөл: —" />
                            <TextBlock x:Name="ContextStatus" Style="{StaticResource MutedText}" Margin="0,4,0,0" />

                            <!-- Төсөл сонгох (бүртгэлгүй / хоёрдмол файл) -->
                            <StackPanel x:Name="ChoicePanel" Visibility="Collapsed" Margin="0,6,0,0">
                                <TextBlock x:Name="ChoiceTitle" Style="{StaticResource DarkText}" FontSize="12" />
                                <ListBox x:Name="ChoiceList" Margin="0,4,0,0" MaxHeight="170" AutomationProperties.Name="Төсөл сонгох жагсаалт"
                                         DisplayMemberPath="Label"
                                         SelectionChanged="ChoiceList_SelectionChanged" />
                                <Button x:Name="ChoiceBtn" Style="{StaticResource PrimaryButton}" Margin="0,6,0,0"
                                        HorizontalAlignment="Left" IsEnabled="False" Click="ChoiceBtn_Click" />
                            </StackPanel>

                            <!-- Таск сонгох -->
                            <StackPanel x:Name="TaskPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource MutedText}" Text="Одоо аль таск дээр ажиллаж байна вэ?" />
                                <ComboBox x:Name="TaskCombo" Margin="0,3,0,0" AutomationProperties.Name="Одоо ажиллаж буй таск"
                                          DisplayMemberPath="Label" SelectionChanged="TaskCombo_SelectionChanged" />
                                <TextBlock x:Name="TaskNote" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                <Button x:Name="ClearTaskBtn" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                        Content="Таскийн сонголтыг цуцлах" Click="ClearTaskBtn_Click"
                                        Visibility="Collapsed" Margin="-4,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Явц ба өдрийн тайлан -->
                    <Border x:Name="ReportCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="ЯВЦ БА ТАЙЛАН" />
                            <TextBlock x:Name="CurrentLine" Style="{StaticResource DarkText}" FontSize="12" />

                            <!-- Хувиар явдаг таск -->
                            <StackPanel x:Name="PercentPanel" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource DarkText}" VerticalAlignment="Center"
                                               Margin="0,0,8,0" Text="Явц %" />
                                    <TextBox x:Name="PercentBox" Grid.Column="1" AutomationProperties.Name="Явц, хувиар"
                                             HorizontalContentAlignment="Right" />
                                    <TextBlock x:Name="PercentHint" Grid.Column="2" Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,2" Text="Өнөөдөр юу хийсэн бэ? (богино)" />
                                <TextBox x:Name="NotesBox" Height="70" AutomationProperties.Name="Өнөөдөр юу хийсэн бэ" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                                <CheckBox x:Name="CompleteCheck" Margin="0,8,0,0"
                                          Content="Энэ таскийг ДУУСГАХ (100%)" Checked="CompleteCheck_Changed"
                                          Unchecked="CompleteCheck_Changed" />
                                <StackPanel x:Name="QuestionsPanel" Visibility="Collapsed" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="SendBtn" Style="{StaticResource PrimaryButton}" Content="Тайлан илгээх"
                                            Click="SendBtn_Click" />
                                    <Button x:Name="OpenWebBtn" Style="{StaticResource LinkButton}" Margin="8,0,0,0"
                                            Content="Вэб дээр нээх" Click="OpenWebBtn_Click" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Цагаар явдаг (ZA засвар) таск -->
                            <StackPanel x:Name="HoursPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource MutedText}"
                                           Text="Засварын таск — хувь бөглөхгүй. «Ажилласан» гэж тэмдэглэхэд цагийг систем бодно (вэбийн «Миний ажлууд»-тай ижил)." />
                                <Button x:Name="MarkBtn" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" Content="Өнөөдөр ажилласан" Click="MarkBtn_Click" />
                            </StackPanel>

                            <TextBlock x:Name="ReportStatus" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!--
                      Ил мэдэгдэл (эзний 2026-08-27-ны «мэдэгдэнэ, татгалзах товчгүй» шийдвэр).
                      2026-09-29-нөөс цаг бүртгэл ДАЛД (харагдац байхгүй) тул «ERP-ийн админд
                      харагдана» гэсэн хэсэг ХУДАЛ болж хасагдав; бүртгэдэг гэдгийг ҮНЭНЭЭР
                      хэлнэ.  Мэдэгдлийг бүхэлд нь авах эсэх нь эзний шийдвэр — өөрөө бүү хас.
                    -->
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               Text="MGL-ийн Revit нэмэлт нь сонгосон таск дээр Revit-д идэвхтэй ажилласан хугацааг бүртгэдэг. Товчлуур, дэлгэцийн зураг, файлын агуулга, бусад програм цуглуулахгүй." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
