<Window x:Class="RevitMcpAddin.QtoProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MGL — Тоо хэмжээг ERP-д илгээж байна"
        Width="560"
        SizeToContent="Height"
        MaxHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Closing="Window_Closing"
        ContentRendered="Window_ContentRendered">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Margin="0,0,0,4"
                   FontWeight="SemiBold" Text="Файлуудыг задалж, ERP-д илгээж байна…"
                   TextWrapping="Wrap" />

        <!-- Нөхцөл байдлыг ЧИМЭЭГҮЙ хэлэх: Revit энэ хооронд түгжигдэнэ, цуцлах нь файлын хилд л зогсоно. -->
        <TextBlock x:Name="NoteText" Grid.Row="1" Margin="0,0,0,10" Style="{DynamicResource MglMuted}"
                   Text="Revit энэ хооронд түгжигдэнэ. «Цуцлах» дарахад одоо илгээж буй файл дуустал хүлээж, дараагийн файлуудыг алгасна." />

        <ScrollViewer Grid.Row="2" MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <ItemsControl x:Name="FileList" AutomationProperties.Name="Файл бүрийн илгээлтийн төлөв">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding FileName}" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgMuted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Working">
                                                <Setter Property="Foreground" Value="{DynamicResource Info}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Ok">
                                                <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Failed">
                                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Skipped">
                                                <Setter Property="Foreground" Value="{DynamicResource Warn}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ProgressBar x:Name="OverallBar" Grid.Row="3" Height="14" Margin="0,0,0,10"
                     Background="{DynamicResource Line}" Foreground="{DynamicResource Accent}"
                     AutomationProperties.Name="Нийт явц" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="0,0,12,0" Style="{DynamicResource MglMuted}" />
            <Button x:Name="CancelBtn" Content="Цуцлах" Width="110" Click="CancelBtn_Click" />
        </StackPanel>
    </Grid>
</Window>
