<Window x:Class="RevitMcpAddin.SheetNumerator.Ui.SheetNumeratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RevitMcpAddin.SheetNumerator.Ui"
        Title="MGL — Хуудас дугаарлах"
        Width="1180"
        Height="780"
        MinWidth="960"
        MinHeight="620"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="SheetNumeratorWindow">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <local:NotConverter x:Key="Not" />
        <local:EmptyToCollapsedConverter x:Key="EmptyCollapsed" />
        <local:FieldErrorBrushConverter x:Key="ErrBrush" />
        <local:FieldErrorTextConverter x:Key="ErrText" />
        <local:PartFieldErrorBrushConverter x:Key="PartErrBrush" />
        <local:PartFieldErrorTextConverter x:Key="PartErrText" />


        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="3,0" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Section" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource BgRaised}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <!-- Жагсаалтын мөр: төлөвөөр өнгөлнө -->
        <Style x:Key="RowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Changed">
                    <Setter Property="Background" Value="{DynamicResource InfoBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource WarnBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Төлөвийн дүрс (Segoe UI Symbol) -->
        <Style x:Key="StateGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Text" Value="" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Changed">
                    <Setter Property="Text" Value="●" />
                    <Setter Property="Foreground" Value="{DynamicResource Info}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warning">
                    <Setter Property="Text" Value="⚠" />
                    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter Property="Text" Value="✖" />
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NewNumberText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Info}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusLine" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusState}" Value="Error">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="Changed">
                    <Setter Property="Foreground" Value="{DynamicResource Info}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Хэсгийн (Part) загвар -->
        <DataTemplate x:Key="PartTemplate">
            <Border Style="{StaticResource Section}" Margin="0,0,0,8" Background="{DynamicResource Bg}">
                <StackPanel>
                    <CheckBox IsChecked="{Binding Enabled}" FontWeight="SemiBold" Content="{Binding Title}" Margin="0,0,0,6" />
                    <StackPanel IsEnabled="{Binding Enabled}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Угтвар" Style="{StaticResource FieldLabel}" />
                                <TextBox AutomationProperties.Name="Угтвар" Style="{StaticResource Field}" Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.BorderBrush>
                                        <MultiBinding Converter="{StaticResource PartErrBrush}" ConverterParameter="prefix">
                                            <Binding Path="DataContext.FieldErrors" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            <Binding Path="Index" />
                                        </MultiBinding>
                                    </TextBox.BorderBrush>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Утга" Style="{StaticResource FieldLabel}" />
                                <ComboBox AutomationProperties.Name="Утга" ItemsSource="{Binding ValueModes}" SelectedItem="{Binding ValueMode}" DisplayMemberPath="Label" Height="24" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Дагавар" Style="{StaticResource FieldLabel}" />
                                <TextBox AutomationProperties.Name="Дагавар" Style="{StaticResource Field}" Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.BorderBrush>
                                        <MultiBinding Converter="{StaticResource PartErrBrush}" ConverterParameter="suffix">
                                            <Binding Path="DataContext.FieldErrors" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            <Binding Path="Index" />
                                        </MultiBinding>
                                    </TextBox.BorderBrush>
                                </TextBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,6,0,0" Visibility="{Binding HasNumber, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Эхлэх" Style="{StaticResource FieldLabel}" />
                                <TextBox AutomationProperties.Name="Эхлэх" Style="{StaticResource Field}" Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.BorderBrush>
                                        <MultiBinding Converter="{StaticResource PartErrBrush}" ConverterParameter="start">
                                            <Binding Path="DataContext.FieldErrors" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            <Binding Path="Index" />
                                        </MultiBinding>
                                    </TextBox.BorderBrush>
                                    <TextBox.ToolTip>
                                        <MultiBinding Converter="{StaticResource PartErrText}" ConverterParameter="start">
                                            <Binding Path="DataContext.FieldErrors" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            <Binding Path="Index" />
                                        </MultiBinding>
                                    </TextBox.ToolTip>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Visibility="{Binding IsAdvancing, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Алхам" Style="{StaticResource FieldLabel}" />
                                <TextBox AutomationProperties.Name="Алхам" Style="{StaticResource Field}" Text="{Binding StepText, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.BorderBrush>
                                        <MultiBinding Converter="{StaticResource PartErrBrush}" ConverterParameter="step">
                                            <Binding Path="DataContext.FieldErrors" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            <Binding Path="Index" />
                                        </MultiBinding>
                                    </TextBox.BorderBrush>
                                    <TextBox.ToolTip>
                                        <MultiBinding Converter="{StaticResource PartErrText}" ConverterParameter="step">
                                            <Binding Path="DataContext.FieldErrors" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            <Binding Path="Index" />
                                        </MultiBinding>
                                    </TextBox.ToolTip>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Дугаарын орон" Style="{StaticResource FieldLabel}" />
                                <TextBox AutomationProperties.Name="Дугаарын орон" Style="{StaticResource Field}" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.BorderBrush>
                                        <MultiBinding Converter="{StaticResource PartErrBrush}" ConverterParameter="width">
                                            <Binding Path="DataContext.FieldErrors" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            <Binding Path="Index" />
                                        </MultiBinding>
                                    </TextBox.BorderBrush>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Grid.Column="6" Visibility="{Binding IsAdvancing, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Хязгаар" Style="{StaticResource FieldLabel}" />
                                <TextBox AutomationProperties.Name="Хязгаар" Style="{StaticResource Field}" Text="{Binding LimitText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Хоосон = хязгааргүй. Өсөх дараалалд хамгийн их, буурахад хамгийн бага утга.">
                                    <TextBox.BorderBrush>
                                        <MultiBinding Converter="{StaticResource PartErrBrush}" ConverterParameter="limit">
                                            <Binding Path="DataContext.FieldErrors" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            <Binding Path="Index" />
                                        </MultiBinding>
                                    </TextBox.BorderBrush>
                                </TextBox>
                            </StackPanel>
                        </Grid>

                        <CheckBox Margin="0,6,0,0" IsChecked="{Binding Wrap}"
                                  Visibility="{Binding IsAdvancing, Converter={StaticResource BoolToVis}}"
                                  ToolTip="Жишээ: хэсэг 2-ийн хязгаар 3 бол A-1-1, A-1-2, A-1-3, A-2-1 …">
                            <TextBlock TextWrapping="Wrap" Text="Хязгаарт хүрвэл эхлэх утга руу буцаж, өмнөх хэсгийг нэмэх" />
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding ApplyCommand}" />
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding MoveUpCommand}" />
        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding MoveDownCommand}" />
        <KeyBinding Key="Home" Modifiers="Alt" Command="{Binding MoveTopCommand}" />
        <KeyBinding Key="End" Modifiers="Alt" Command="{Binding MoveBottomCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Баннер: хуучирсан / document солигдсон ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource Warn}" BorderThickness="0,0,0,1" Padding="12,8"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}"
                AutomationProperties.AutomationId="StaleBanner">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Жагсаалтыг шинэчлэх" Command="{Binding RefreshCommand}" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" Foreground="{DynamicResource Warn}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12,10,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="500" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="410" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- ═══════════ ЗҮҮН: бүлэг + хуудасны жагсаалт ═══════════ -->
            <DockPanel Grid.Column="0">

                <!-- Хэрэгслийн мөр -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <WrapPanel>
                        <RadioButton Content="Бүлэглэж харах" IsChecked="{Binding IsGroupedMode}" GroupName="DisplayMode" Margin="0,3,14,3"
                                     ToolTip="Project Browser-ийн одоогийн Browser Organization-ий дагуу" AutomationProperties.AutomationId="ModeGrouped" />
                        <RadioButton Content="Бүгдийг нэг бүлэгт" IsChecked="{Binding IsAllInOneMode}" GroupName="DisplayMode" Margin="0,3,14,3"
                                     AutomationProperties.AutomationId="ModeAllInOne" />
                        <CheckBox Content="Хуудасны нэрээр эрэмбэлэх" IsChecked="{Binding SortByName}" IsEnabled="{Binding CanSortByName}" Margin="0,3,14,3"
                                  ToolTip="«Бүгдийг нэг бүлэгт» горимд — тогтвортой эрэмбэ" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="Жагсаалтыг шинэчлэх" Command="{Binding RefreshCommand}" Style="{StaticResource ToolButton}" ToolTip="F5"
                                AutomationProperties.AutomationId="RefreshButton" />
                        <ToggleButton IsChecked="{Binding HidePreview}" Content="{Binding HidePreviewLabel}" Padding="8,0" Height="26" Margin="0,0,10,0"
                                      ToolTip="Зөвхөн харагдацыг нууна — тохиргоо, тооцоо хэвээр. (Revit-ийн Undo/Redo БИШ)"
                                      AutomationProperties.AutomationId="HidePreviewToggle" />
                        <Button Content="▲" AutomationProperties.Name="Дээш зөөх" Command="{Binding MoveUpCommand}" Style="{StaticResource ToolButton}" ToolTip="Дээш (Alt+↑)" AutomationProperties.AutomationId="MoveUp" />
                        <Button Content="▼" AutomationProperties.Name="Доош зөөх" Command="{Binding MoveDownCommand}" Style="{StaticResource ToolButton}" ToolTip="Доош (Alt+↓)" AutomationProperties.AutomationId="MoveDown" />
                        <Button Content="⤒" AutomationProperties.Name="Хамгийн дээш зөөх" Command="{Binding MoveTopCommand}" Style="{StaticResource ToolButton}" ToolTip="Хамгийн дээш (Alt+Home)" AutomationProperties.AutomationId="MoveTop" />
                        <Button Content="⤓" AutomationProperties.Name="Хамгийн доош зөөх" Command="{Binding MoveBottomCommand}" Style="{StaticResource ToolButton}" ToolTip="Хамгийн доош (Alt+End)" AutomationProperties.AutomationId="MoveBottom" />
                        <Button Content="Дарааллыг буцаах" Command="{Binding ResetOrderCommand}" Style="{StaticResource ToolButton}"
                                ToolTip="Зөөсөн дарааллыг Project Browser-ийн анхны дараалалд буцаана" />
                    </WrapPanel>
                    <CheckBox Margin="0,6,0,0" IsChecked="{Binding MoveRenumber}" IsEnabled="{Binding CanToggleMoveRenumber}"
                              Content="Зөөхөд дугаарыг дагуулж шинэчлэх"
                              AutomationProperties.AutomationId="MoveRenumber"
                              ToolTip="Хуудас бүр өөрийн байрлалын (бүлгийн анхны) дугаарыг авна. Дараалал энэ горимгүйгээр зөөгдсөн бол эхлээд «Хэрэгжүүлэх» эсвэл «Жагсаалтыг шинэчлэх» дарна уу." />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Warn}"
                               Text="{Binding GlobalWarningText}"
                               Visibility="{Binding HasGlobalWarnings, Converter={StaticResource BoolToVis}}"
                               AutomationProperties.AutomationId="OrderWarning" />
                </StackPanel>

                <!-- Мод + жагсаалт -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Visibility="{Binding ShowTree, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Бүлгүүд" Style="{StaticResource FieldLabel}" />
                        <TreeView x:Name="GroupTree" Grid.Row="1" ItemsSource="{Binding TreeRoots}" Height="150"
                                  BorderBrush="{DynamicResource Line}" AllowDrop="True"
                                  AutomationProperties.AutomationId="GroupTree">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="{Binding Title}" />
                                        <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource FgMuted}" Margin="6,0,0,0" />
                                        <TextBlock Text=" ●" Foreground="{DynamicResource Warn}"
                                                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"
                                                   ToolTip="Дараалал өөрчлөгдсөн, хэрэгжүүлээгүй" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>

                    <DockPanel Grid.Row="1">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding GroupHeader}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" />
                        <Grid>
                            <ListView x:Name="SheetList" ItemsSource="{Binding Rows}" SelectionMode="Extended" AllowDrop="True"
                                      ItemContainerStyle="{StaticResource RowStyle}"
                                      BorderBrush="{DynamicResource Line}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      AutomationProperties.AutomationId="SheetList">
                                <ListView.ContextMenu>
                                    <ContextMenu x:Name="RowMenu">
                                        <MenuItem Header="Хуудасны нэр өөрчлөх" Click="OnRenameClick" />
                                        <MenuItem Header="Хуудас устгах" Click="OnDeleteClick" />
                                        <Separator />
                                        <MenuItem Header="Дээш" Command="{Binding MoveUpCommand}" InputGestureText="Alt+↑" />
                                        <MenuItem Header="Доош" Command="{Binding MoveDownCommand}" InputGestureText="Alt+↓" />
                                        <MenuItem Header="Хамгийн дээш" Command="{Binding MoveTopCommand}" InputGestureText="Alt+Home" />
                                        <MenuItem Header="Хамгийн доош" Command="{Binding MoveBottomCommand}" InputGestureText="Alt+End" />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.View>
                                    <GridView AllowsColumnReorder="False">
                                        <GridViewColumn Width="28">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{StaticResource StateGlyph}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Одоогийн дугаар" Width="130">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CurrentNumber}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Шинэ дугаар" Width="140">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding NewNumberDisplay}" Style="{StaticResource NewNumberText}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Хуудасны нэр" Width="210">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <!-- Нэр урт бол «…»-ээр тасарч, «Assembly»/«Placeholder» шошго ҮРГЭЛЖ харагдана. -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding NameDisplay}" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding NameDisplay}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding NameWillChange}" Value="True">
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource Info}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="6,2,0,0"
                                                                   Visibility="{Binding Kind, Converter={StaticResource EmptyCollapsed}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Төлөв" Width="230">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FgMuted}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock Text="{Binding EmptyHint}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FgMuted}"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </DockPanel>

            <!-- ═══════════ БАРУУН: дугаарлалтын тохиргоо ═══════════ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <StackPanel>

                    <!-- Энгийн / Нарийвчилсан -->
                    <TabControl SelectedIndex="{Binding NumberingTabIndex, Mode=TwoWay}" IsEnabled="{Binding NumberingControlsEnabled}"
                                AutomationProperties.AutomationId="NumberingTabs">
                        <TabItem Header="Энгийн дугаарлалт" AutomationProperties.AutomationId="TabSimple">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="Угтвар" Style="{StaticResource FieldLabel}" />
                                    <TextBox AutomationProperties.Name="Угтвар" Style="{StaticResource Field}" Text="{Binding SimplePrefix, UpdateSourceTrigger=PropertyChanged}"
                                             BorderBrush="{Binding FieldErrors, Converter={StaticResource ErrBrush}, ConverterParameter=simple.prefix}"
                                             ToolTip="{Binding FieldErrors, Converter={StaticResource ErrText}, ConverterParameter=simple.prefix}"
                                             AutomationProperties.AutomationId="SimplePrefix" />
                                </StackPanel>

                                <CheckBox Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Content="Эхлэх дугаар ашиглах" IsChecked="{Binding SimpleUseStart}"
                                          AutomationProperties.AutomationId="SimpleUseStart"
                                          ToolTip="Унтраавал: Угтвар + ОДООГИЙН дугаар + Дагавар" />

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,6,0,0" IsEnabled="{Binding SimpleStartEnabled}">
                                    <TextBlock Text="Эхлэх дугаар" Style="{StaticResource FieldLabel}" />
                                    <TextBox AutomationProperties.Name="Эхлэх дугаар" Style="{StaticResource Field}" Text="{Binding SimpleStartText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderBrush="{Binding FieldErrors, Converter={StaticResource ErrBrush}, ConverterParameter=simple.start}"
                                             ToolTip="{Binding FieldErrors, Converter={StaticResource ErrText}, ConverterParameter=simple.start}"
                                             AutomationProperties.AutomationId="SimpleStart" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,6,0,0" IsEnabled="{Binding SimpleStartEnabled}">
                                    <TextBlock Text="Дугаарын орон" Style="{StaticResource FieldLabel}" />
                                    <TextBox AutomationProperties.Name="Дугаарын орон" Style="{StaticResource Field}" Text="{Binding SimpleWidthText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderBrush="{Binding FieldErrors, Converter={StaticResource ErrBrush}, ConverterParameter=simple.width}"
                                             ToolTip="{Binding FieldErrors, Converter={StaticResource ErrText}, ConverterParameter=simple.width}"
                                             AutomationProperties.AutomationId="SimpleWidth" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                    <TextBlock Text="Дагавар" Style="{StaticResource FieldLabel}" />
                                    <TextBox AutomationProperties.Name="Дагавар" Style="{StaticResource Field}" Text="{Binding SimpleSuffix, UpdateSourceTrigger=PropertyChanged}"
                                             BorderBrush="{Binding FieldErrors, Converter={StaticResource ErrBrush}, ConverterParameter=simple.suffix}"
                                             ToolTip="{Binding FieldErrors, Converter={StaticResource ErrText}, ConverterParameter=simple.suffix}"
                                             AutomationProperties.AutomationId="SimpleSuffix" />
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Нарийвчилсан тохиргоо" AutomationProperties.AutomationId="TabAdvanced">
                            <StackPanel Margin="10">
                                <ItemsControl ItemsSource="{Binding PartList}" ItemTemplate="{StaticResource PartTemplate}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Тусгаарлагч (хэсэг 1 ⟷ 2)" Style="{StaticResource FieldLabel}" />
                                        <ComboBox AutomationProperties.Name="Тусгаарлагч (хэсэг 1 ⟷ 2)" IsEditable="True" Height="24" ItemsSource="{Binding SeparatorChoices}" Text="{Binding Separator1, UpdateSourceTrigger=PropertyChanged}"
                                                  BorderBrush="{Binding FieldErrors, Converter={StaticResource ErrBrush}, ConverterParameter=separator1}"
                                                  ToolTip="Дурын бичвэр байж болно" AutomationProperties.AutomationId="Separator1" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Тусгаарлагч (хэсэг 2 ⟷ 3)" Style="{StaticResource FieldLabel}" />
                                        <ComboBox AutomationProperties.Name="Тусгаарлагч (хэсэг 2 ⟷ 3)" IsEditable="True" Height="24" ItemsSource="{Binding SeparatorChoices}" Text="{Binding Separator2, UpdateSourceTrigger=PropertyChanged}"
                                                  BorderBrush="{Binding FieldErrors, Converter={StaticResource ErrBrush}, ConverterParameter=separator2}"
                                                  ToolTip="Дурын бичвэр байж болно" AutomationProperties.AutomationId="Separator2" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <TextBlock Text="{Binding ModeHint}" TextWrapping="Wrap" Margin="2,8,2,0" Foreground="{DynamicResource Info}"
                               Visibility="{Binding HasModeHint, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="ModeHint" />

                    <!-- Одоогийн дугаарын тоон хэсгийг өөрчлөх -->
                    <Border Style="{StaticResource Section}" IsEnabled="{Binding ShiftControlsEnabled}">
                        <StackPanel>
                            <TextBlock Text="Одоогийн дугаарын тоон хэсгийг өөрчлөх" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource Field}" Text="{Binding ShiftValueText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderBrush="{Binding FieldErrors, Converter={StaticResource ErrBrush}, ConverterParameter=shift.amount}"
                                         ToolTip="{Binding FieldErrors, Converter={StaticResource ErrText}, ConverterParameter=shift.amount}"
                                         AutomationProperties.AutomationId="ShiftValue" />
                                <ToggleButton Grid.Column="2" Content="Өсгөх" IsChecked="{Binding ShiftIncreaseOn}" Height="24"
                                              ToolTip="Тоон хэсэг бүрийг нэмнэ. Дахин дарвал болино." AutomationProperties.AutomationId="ShiftIncrease" />
                                <ToggleButton Grid.Column="4" Content="Бууруулах" IsChecked="{Binding ShiftDecreaseOn}" Height="24"
                                              ToolTip="Тоон хэсэг бүрийг хасна. Дахин дарвал болино." AutomationProperties.AutomationId="ShiftDecrease" />
                            </Grid>
                            <TextBlock Text="Тоон хэсэг" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                            <ComboBox AutomationProperties.Name="Тоон хэсэг" ItemsSource="{Binding ShiftTokenOptions}" SelectedItem="{Binding ShiftToken}" DisplayMemberPath="Label" Height="24"
                                      ToolTip="Дугаарт хэд хэдэн тоо байвал (A-01-02) аль нэгийг сонгоно. Өгөгдмөл: сүүлийнх."
                                      AutomationProperties.AutomationId="ShiftToken" />
                        </StackPanel>
                    </Border>

                    <!-- Параметрээс угтвар / дагавар -->
                    <Border Style="{StaticResource Section}" IsEnabled="{Binding NumberingControlsEnabled}">
                        <StackPanel>
                            <TextBlock Text="Параметр" Style="{StaticResource SectionTitle}" />
                            <CheckBox Content="Параметрээс угтвар авах" IsChecked="{Binding UseParameterPrefix}" AutomationProperties.AutomationId="UseParamPrefix" />
                            <ComboBox ItemsSource="{Binding SourceParameterOptions}" SelectedItem="{Binding PrefixParameter}" DisplayMemberPath="Label" Height="24" Margin="0,3,0,8"
                                      IsEnabled="{Binding UseParameterPrefix}" BorderBrush="{Binding FieldErrors, Converter={StaticResource ErrBrush}, ConverterParameter=affix.prefix}"
                                      ToolTip="{Binding FieldErrors, Converter={StaticResource ErrText}, ConverterParameter=affix.prefix}" />
                            <CheckBox Content="Параметрээс дагавар авах" IsChecked="{Binding UseParameterSuffix}" AutomationProperties.AutomationId="UseParamSuffix" />
                            <ComboBox ItemsSource="{Binding SourceParameterOptions}" SelectedItem="{Binding SuffixParameter}" DisplayMemberPath="Label" Height="24" Margin="0,3,0,0"
                                      IsEnabled="{Binding UseParameterSuffix}" BorderBrush="{Binding FieldErrors, Converter={StaticResource ErrBrush}, ConverterParameter=affix.suffix}"
                                      ToolTip="{Binding FieldErrors, Converter={StaticResource ErrText}, ConverterParameter=affix.suffix}" />
                        </StackPanel>
                    </Border>

                    <!-- Үр дүнг параметрт бичих / бүлгийн хуудасны тоо -->
                    <Border Style="{StaticResource Section}" IsEnabled="{Binding ExtrasEnabled}">
                        <StackPanel>
                            <CheckBox Content="Үр дүнг параметрт бичих" IsChecked="{Binding WriteResult}" FontWeight="SemiBold" AutomationProperties.AutomationId="WriteResult" />
                            <Grid Margin="0,4,0,10" IsEnabled="{Binding WriteResult}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding TargetParameterOptions}" SelectedItem="{Binding ResultParameter}" DisplayMemberPath="Label" Height="24"
                                          BorderBrush="{Binding FieldErrors, Converter={StaticResource ErrBrush}, ConverterParameter=write.parameter}"
                                          ToolTip="{Binding FieldErrors, Converter={StaticResource ErrText}, ConverterParameter=write.parameter}" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding ResultSource}" DisplayMemberPath="Label" Height="24"
                                          BorderBrush="{Binding FieldErrors, Converter={StaticResource ErrBrush}, ConverterParameter=write.source}"
                                          ToolTip="{Binding FieldErrors, Converter={StaticResource ErrText}, ConverterParameter=write.source}" />
                            </Grid>

                            <CheckBox Content="Бүлгийн хуудасны тоог параметрт бичих" IsChecked="{Binding WriteGroupCount}" FontWeight="SemiBold" AutomationProperties.AutomationId="WriteGroupCount" />
                            <StackPanel Margin="0,4,0,0" IsEnabled="{Binding WriteGroupCount}">
                                <ComboBox ItemsSource="{Binding TargetParameterOptions}" SelectedItem="{Binding CountParameter}" DisplayMemberPath="Label" Height="24"
                                          BorderBrush="{Binding FieldErrors, Converter={StaticResource ErrBrush}, ConverterParameter=count.parameter}"
                                          ToolTip="{Binding FieldErrors, Converter={StaticResource ErrText}, ConverterParameter=count.parameter}" />
                                <RadioButton Content="Зөвхөн эхний хуудсанд" IsChecked="{Binding CountToFirst}" GroupName="CountScope" Margin="0,6,0,0"
                                             ToolTip="«Сонгосон хуудаснаас эхлэх» асаалттай бол — өөрчлөгдөх эхний хуудас" />
                                <RadioButton Content="Бүх хуудсанд" IsChecked="{Binding CountToAll}" GroupName="CountScope" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Хуудасны нэрэнд дугаар -->
                    <Border Style="{StaticResource Section}" IsEnabled="{Binding ExtrasEnabled}">
                        <StackPanel>
                            <CheckBox Content="Хуудасны нэрийн эхэнд дугаар нэмэх" IsChecked="{Binding NameAtStart}" AutomationProperties.AutomationId="NameAtStart" />
                            <CheckBox Content="Хуудасны нэрийн төгсгөлд дугаар нэмэх" IsChecked="{Binding NameAtEnd}" Margin="0,3,0,0" AutomationProperties.AutomationId="NameAtEnd" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Нэмэх хэсэг" Style="{StaticResource FieldLabel}" />
                                    <ComboBox AutomationProperties.Name="Нэмэх хэсэг" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding NameSource}" DisplayMemberPath="Label" Height="24"
                                              BorderBrush="{Binding FieldErrors, Converter={StaticResource ErrBrush}, ConverterParameter=name.source}"
                                              ToolTip="{Binding FieldErrors, Converter={StaticResource ErrText}, ConverterParameter=name.source}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Тусгаарлагч" Style="{StaticResource FieldLabel}" />
                                    <TextBox AutomationProperties.Name="Тусгаарлагч" Style="{StaticResource Field}" Text="{Binding NameSeparator, UpdateSourceTrigger=PropertyChanged}"
                                             BorderBrush="{Binding FieldErrors, Converter={StaticResource ErrBrush}, ConverterParameter=name.separator}"
                                             ToolTip="{Binding FieldErrors, Converter={StaticResource ErrText}, ConverterParameter=name.separator}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Сонгосон хуудаснаас эхлэх -->
                    <Border Style="{StaticResource Section}">
                        <CheckBox Content="Сонгосон хуудаснаас эхлэх" IsChecked="{Binding StartFromSelected}" IsEnabled="{Binding StartFromSelectedEnabled}"
                                  AutomationProperties.AutomationId="StartFromSelected"
                                  ToolTip="Зөвхөн жагсаалтад сонгосон хуудаснаас доошхи хуудсууд өөрчлөгдөнө. Өмнөх хуудсууд хэвээр, гэхдээ давхардлын шалгалтад оролцоно." />
                    </Border>

                    <!-- Хэвлэгддэггүй Unicode тэмдэг -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Хэвлэгддэггүй Unicode тэмдэг" Style="{StaticResource SectionTitle}" />
                            <CheckBox Content="Давхардлыг хэвлэгддэггүй Unicode тэмдэг ашиглан ялгах" IsChecked="{Binding UseMarkers}" IsEnabled="{Binding NumberingControlsEnabled}"
                                      AutomationProperties.AutomationId="UseMarkers">
                                <CheckBox.ToolTip>
                                    <TextBlock Width="320" TextWrapping="Wrap"
                                               Text="Харагдахдаа ижил боловч дотроо өөр Unicode тэмдэгтэй дугаар үүсгэнэ. Идэвхжүүлэхээс өмнө энэ Revit тэр тэмдгийг дугаарт хадгалдаг эсэхийг бодитоор шалгана." />
                                </CheckBox.ToolTip>
                            </CheckBox>
                            <ComboBox Margin="0,6,0,0" ItemsSource="{Binding MarkerOptions}" SelectedValuePath="Value" SelectedValue="{Binding MarkerChar}" DisplayMemberPath="Label" Height="24"
                                      IsEnabled="{Binding UseMarkers}"
                                      BorderBrush="{Binding FieldErrors, Converter={StaticResource ErrBrush}, ConverterParameter=markers.char}"
                                      ToolTip="{Binding FieldErrors, Converter={StaticResource ErrText}, ConverterParameter=markers.char}" />
                            <TextBlock Text="{Binding MarkerStatus}" Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding MarkerStatus, Converter={StaticResource EmptyCollapsed}}" />
                            <ToggleButton Margin="0,8,0,0" Height="26" Content="Хэвлэгддэггүй тэмдэг цэвэрлэх" IsChecked="{Binding CleanActive, Mode=OneWay}"
                                          Command="{Binding CleanMarkersCommand}" HorizontalAlignment="Left" Padding="10,0"
                                          ToolTip="Одоогийн бүлгийн дугаараас мэдэгдэж буй үл үзэгдэх тэмдгийг устгана (урьдчилж харуулаад «Хэрэгжүүлэх»)."
                                          AutomationProperties.AutomationId="CleanMarkers" />
                        </StackPanel>
                    </Border>

                    <!-- Тохиргооны алдаа -->
                    <ItemsControl ItemsSource="{Binding SettingsErrors}" Margin="0,8,0,0" Visibility="{Binding HasSettingsErrors, Converter={StaticResource BoolToVis}}"
                                  AutomationProperties.AutomationId="SettingsErrors">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════ ДООД: төлөв + Хэрэгжүүлэх ═══════════ -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Bg}" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Хэрэгжүүлэх" Command="{Binding ApplyCommand}" MinWidth="130" Height="30" FontWeight="SemiBold" Margin="0,0,8,0"
                            ToolTip="Ctrl+Enter" AutomationProperties.AutomationId="ApplyButton" />
                    <Button Content="Хаах" Click="OnCloseClick" MinWidth="80" Height="30" IsCancel="False" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,12,0">
                    <ProgressBar IsIndeterminate="True" Width="70" Height="8" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BusyText}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource FgMuted}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusLine}" AutomationProperties.AutomationId="StatusText"
                           ToolTip="{Binding StatusText}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
