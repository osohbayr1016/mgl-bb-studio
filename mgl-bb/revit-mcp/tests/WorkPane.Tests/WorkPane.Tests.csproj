<Project Sdk="Microsoft.NET.Sdk">

  <!--
    «MGL ажил» самбарын (Revit work tracking MVP, Session 3) ЦЭВЭР дүрмийн тест.

    ⚠️ Гадаад пакет БАЙХГҮЙ (Intelligence.Tests / WorkTracking.Tests-ийн ижил
    шалтгаан: сүлжээгүй машин дээр ч `dotnet run` ажиллах ёстой).  Жижиг
    өөрийн runner.

    ⚠️ Revit/WPF assembly ЭНД ОРОХГҮЙ — `addin/WorkPane/Core` дотор
    `Autodesk.Revit` эсвэл `System.Windows` гарвал энэ төсөл ЭМХЭТГЭГДЭХГҮЙ.
    Тэр нь зориудын хамгаалалт: самбарын шийдвэр бүр энд тестлэгдэнэ.

      dotnet run   (revit-mcp/tests/WorkPane.Tests хавтаснаас)
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WorkPane.Tests</AssemblyName>
    <RootNamespace>RevitMcpAddin.WorkPane.Tests</RootNamespace>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\addin\WorkPane\Core\*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

</Project>
