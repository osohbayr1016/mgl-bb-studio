<Project Sdk="Microsoft.NET.Sdk">

  <!--
    «Ханын дэлгээс»-ийн WPF цонхны Revit-гүй ТҮЦ ШАЛГАЛТ (smoke): бодит цэвэр төлөвлөгчөөр (Core) урьдчилсан дүн үүсгэж,
    цонхыг нээж, удирдлагыг дарж, PNG зураг болгон хадгална (SMOKE_OUT хавтас) — layout-ыг нүдээр шалгахад.

    ⚠️ Revit assembly ЭНД ОРОХГҮЙ: `addin/WallElevation/Ui/*.cs` дотор `Autodesk.Revit` гарвал энэ төсөл ЭМХЭТГЭГДЭХГҮЙ.
    ⚠️ Интерактив Windows desktop session шаардана.

      dotnet run   (revit-mcp/tests/WallElevation.UiSmoke хавтаснаас)
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WallElevation.UiSmoke</AssemblyName>
    <RootNamespace>RevitMcpAddin.WallElevation.UiSmoke</RootNamespace>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\addin\WallElevation\Core\*.cs" />
    <Compile Include="..\..\addin\WallElevation\Ui\*.cs" />
    <Compile Include="..\..\addin\Ui\Core\*.cs" />
    <Compile Include="..\..\addin\TextFold.cs" />
    <Compile Include="..\..\addin\Ui\MglStyles.cs" />
    <Compile Include="..\..\addin\Ui\MglTheme.cs" />
    <Compile Include="..\..\addin\Ui\MglBrushes.cs" />
    <Compile Include="..\..\addin\Ui\MglWindow.cs" />
    <Compile Include="..\..\addin\Ui\MglUiPrefs.cs" />
    <Compile Include="..\..\addin\Ui\MglNative.cs" />
    <Compile Include="..\..\addin\Ui\MglUi.cs" />
    <Compile Include="..\..\addin\Ui\MglAuto.cs" />
    <EmbeddedResource Include="..\..\addin\Ui\Resources\MglControls.xaml" LogicalName="RevitMcpAddin.Ui.MglControls.xaml" />
    <Compile Include="..\Smart.UiSmoke\SmokeKit.cs" Link="SmokeKit.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

</Project>
