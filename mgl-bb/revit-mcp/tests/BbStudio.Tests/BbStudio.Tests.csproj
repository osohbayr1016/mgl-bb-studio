<Project Sdk="Microsoft.NET.Sdk">

  <!--
    «MGL ББ Студи»-ийн Revit-гүй цөмийн тест (bbstudio/Core): JSON, XLSX, «Асуудал – Шийдэл», стандарт сурах статистик.
    ⚠️ Revit/WPF assembly ЭНД ОРОХГҮЙ — bbstudio/Core дотор Autodesk.Revit гарвал энэ төсөл ЭМХЭТГЭГДЭХГҮЙ.

      dotnet run   (revit-mcp/tests/BbStudio.Tests хавтаснаас)
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BbStudio.Tests</AssemblyName>
    <RootNamespace>MglBb.Tests</RootNamespace>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\bbstudio\Core\*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

</Project>
