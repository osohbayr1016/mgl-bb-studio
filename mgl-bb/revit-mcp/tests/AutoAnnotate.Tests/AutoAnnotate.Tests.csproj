<Project Sdk="Microsoft.NET.Sdk">

  <!--
    «Автомат хэмжээс»-ийн Revit-гүй цэвэр дүрмийн тест (2026-09-30): гадна хана таних
    (туяа), булангийн сонголт, гинж эрэмбэлэх/нэгтгэх, хүрээ ба тал, дотор гинжийн шугам.

    ⚠️ Revit/WPF assembly ЭНД ОРОХГҮЙ — `addin/AutoAnnotate/Core` дотор
    `Autodesk.Revit` эсвэл `System.Windows` гарвал энэ төсөл ЭМХЭТГЭГДЭХГҮЙ.

      dotnet run   (revit-mcp/tests/AutoAnnotate.Tests хавтаснаас)
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AutoAnnotate.Tests</AssemblyName>
    <RootNamespace>RevitMcpAddin.AutoAnnotate.Tests</RootNamespace>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\addin\AutoAnnotate\Core\*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

</Project>
