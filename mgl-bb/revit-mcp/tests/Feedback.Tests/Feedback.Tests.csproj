<Project Sdk="Microsoft.NET.Sdk">

  <!--
    «Санал хүсэлт» (F01–F03) — Revit add-in-ий ЦЭВЭР логикийн тест: хязгаар, хүрээ (сервер × tenant × хэрэглэгч),
    офлайн outbox (атом бичилт, процесс хоорондын түгжээ), үе шаттай илгээгч (ноорог → хавсралт/хэсэг → submit),
    ухралт, оношилгоо (mgl-diag/1), барьж чадаагүй алдааны бүртгэл.

    ⚠️ Гадаад пакет БАЙХГҮЙ, Revit/WPF assembly ОРОХГҮЙ — `addin/Feedback/Core` дотор `Autodesk.Revit` эсвэл
    `System.Windows` гарвал энэ төсөл эмхэтгэгдэхгүй (зориудын хамгаалалт).

      dotnet run   (revit-mcp/tests/Feedback.Tests хавтаснаас)
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Feedback.Tests</AssemblyName>
    <RootNamespace>RevitMcpAddin.Feedback.Tests</RootNamespace>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\addin\Feedback\Core\*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

</Project>
