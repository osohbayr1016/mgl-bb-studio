<Project Sdk="Microsoft.NET.Sdk">

  <!--
    «Огтлолын арматурын тэмдэглэгээ»-ний урьдчилсан харагдац (SectionPreview)-ийг Revit-гүйгээр PNG болгон
    render хийж нүдээр шалгах smoke.  Core-ийн planner-ыг синтетик дам нуруу/баганаар ажиллуулна.

      dotnet run  [гаралтын хавтас]    (revit-mcp/tests/Reinforcement.UiSmoke хавтаснаас)
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\addin\Reinforcement\Core\*.cs" />
    <Compile Include="..\..\addin\Reinforcement\Ui\SectionPreview.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

</Project>
