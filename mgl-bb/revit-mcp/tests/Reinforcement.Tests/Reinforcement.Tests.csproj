<Project Sdk="Microsoft.NET.Sdk">

  <!--
    «Арматур» хэрэгслүүдийн (Арматурын төгсгөлийн тэмдэг, Огтлолын арматурын тэмдэглэгээ, Түүвэр хувилах)
    Revit-гүй цэвэр логикийн тест.

    ⚠️ Revit/WPF assembly ЭНД ОРОХГҮЙ — `addin/Reinforcement/Core` дотор `Autodesk.Revit` эсвэл
    `System.Windows` гарвал энэ төсөл ЭМХЭТГЭГДЭХГҮЙ.  Revit-д тулгуурласан зан төлөв (reference, хэмжээс,
    Duplicate) энд тестлэгдэхгүй — `docs/REINFORCEMENT.md`-ийн гар QA жагсаалтыг үз.

      dotnet run   (revit-mcp/tests/Reinforcement.Tests хавтаснаас)
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Reinforcement.Tests</AssemblyName>
    <RootNamespace>RevitMcpAddin.Reinforcement.Tests</RootNamespace>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\addin\Reinforcement\Core\*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

</Project>
